[Unit]
Description=Agent Office isolated Claude Q&A controller (review required)
After=agent-office.service

[Service]
Type=exec
User=root
Group=agentoffice
ExecStart=/usr/bin/python3 -I /opt/agent-office-claude-qa/controller.py
WorkingDirectory=/
Environment=PATH=/usr/bin:/bin LANG=C.UTF-8
UMask=0077
RuntimeDirectory=agent-office-claude-qa
RuntimeDirectoryMode=0750
KillMode=control-group
TimeoutStopSec=150s
TasksMax=32
MemoryMax=256M
CPUQuota=100%
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/agent-office-claude-qa /var/lib/agent-office-claude-qa
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# No Install section: this review artifact is not enabled by package installation.
